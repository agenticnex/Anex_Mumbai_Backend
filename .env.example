# Azure Document AI credentials
AZURE_DOCUMENT_AI_KEY=your_azure_document_ai_key
AZURE_DOCUMENT_AI_ENDPOINT=your_azure_document_ai_endpoint
AZURE_DOCUMENT_AI_REGION=your_azure_document_ai_region

# OpenAI credentials
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-nano-2025-04-14

# Supabase credentials
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL credentials
POSTGRES_URL=your_postgres_url
POSTGRES_PRISMA_URL=your_postgres_prisma_url
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_database
POSTGRES_HOST=your_postgres_host
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Azure Blob Storage credentials
AZURE_BLOB_STORAGE_KEY=your_azure_blob_storage_key
AZURE_BLOB_STORAGE_ACCOUNT=your_azure_blob_storage_account
AZURE_BLOB_STORAGE_CONTAINER=your_azure_blob_storage_container
